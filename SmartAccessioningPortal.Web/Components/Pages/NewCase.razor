@page "/cases/new"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using SmartAccessioningPortal.Web.Models
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<PageTitle>Process New Kit</PageTitle>

@if (ShowPreviewModal)
{
    <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="reqPreviewTitle">
        <div class="modal-panel document-preview-modal">
            <div class="modal-header">
                <h2 id="reqPreviewTitle">Requisition Preview</h2>
                <button type="button" class="btn btn-danger btn-sm" @onclick="ClosePdfPreview">
                    Close
                </button>
            </div>

            <div class="document-frame">
                @if (IsSelectedDocumentImage)
                {
                    <img src="@PreviewDocumentUrl" alt="Selected requisition preview" />
                }
                else
                {
                    <iframe title="Selected requisition preview" src="@PreviewDocumentUrl"></iframe>
                }
            </div>
        </div>
    </div>
}

@if (ShowToast)
{
    <div class="toast-message @(ToastBackgroundColor == "#198754" ? "toast-success" : "toast-error")" role="status">
        <span>@ToastMessage</span>
        <button type="button" aria-label="Close notification" @onclick="CloseToast">x</button>
    </div>
}

<div class="portal-page intake-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">San Carlos accessioning</p>
            <h1>Process New Kit</h1>
            <p>Scan the kit, verify the requisition, capture the tube photo, and submit the case to review.</p>
        </div>
        <div class="heading-actions">
            <a class="btn btn-secondary" href="cases">View Case Queue</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert alert-info">@StatusMessage</div>
    }

    <EditForm Model="FormModel" OnValidSubmit="HandleSubmit" FormName="NewCaseForm" class="accession-layout">
        <DataAnnotationsValidator />

        <section class="work-surface accession-form-surface">
            <ValidationSummary class="validation-summary" />

            <div class="section-heading">
                <div>
                    <h2>Scan Intake</h2>
                    <p>Primary operator fields</p>
                </div>
            </div>

            <div class="form-row">
                <label for="kitCode">Kit Code</label>
                <div>
                    <div class="scan-input-group">
                        <InputText id="kitCode" class="form-control" @bind-Value="FormModel.KitBoxCode" placeholder="Scan Kit Barcode" />
                        <span class="scanner-state" title="Scanner ready">-</span>
                    </div>
                    <label class="check-line compact">
                        <InputCheckbox @bind-Value="FormModel.NoKitCode" />
                        <span>No Kit Code</span>
                    </label>
                </div>
            </div>

            <div class="form-row">
                <label for="relabelCode">Relabel Code</label>
                <div>
                    <div class="scan-input-group">
                        <InputText id="relabelCode" class="form-control" @bind-Value="FormModel.RelabelCode" placeholder="Scan New Kit Barcode" />
                        <span class="scanner-state" title="Scanner ready">-</span>
                    </div>
                    <label class="check-line compact">
                        <InputCheckbox @bind-Value="FormModel.NoRelabelCode" />
                        <span>No Relabel Code</span>
                    </label>
                </div>
            </div>

            <div class="form-row">
                <label for="shipmentCode">Shipment</label>
                <div class="scan-input-group">
                    <InputText id="shipmentCode" class="form-control" @bind-Value="FormModel.ShipmentCode" placeholder="Scan Shipment" />
                    <span class="scanner-state" title="Scanner ready">-</span>
                </div>
            </div>

            <div class="form-row">
                <label for="lotCode">Lot Information</label>
                <InputTextArea id="lotCode" class="form-textarea" @bind-Value="FormModel.LotCode" placeholder="Scan Lot Codes" />
            </div>

            <div class="form-row">
                <label for="connectCase">
                    HL7/GC/Connect Case
                    <span class="field-help">(Optional)</span>
                </label>
                <InputText id="connectCase" class="form-control" @bind-Value="FormModel.AccessioningCase" placeholder="Scan Accessioning/Connect ID# or Enter Name" />
            </div>

            <div class="form-row">
                <label>Photo</label>
                <div class="photo-button-row">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="StartCamera">Take Picture</button>
                </div>
            </div>

            <div class="form-row">
                <label for="sampleCode">Add Sample</label>
                <InputText id="sampleCode" class="form-control" @bind-Value="FormModel.SampleCode" placeholder="Scan Sample" />
            </div>

            <div class="form-row">
                <label>
                    Two Patient Identifiers
                    <span class="field-help">Verify each sample.</span>
                </label>
                <div class="segmented-control">
                    <label class="segmented-check">
                        <InputCheckbox @bind-Value="FormModel.IdentifiersConfirmed" />
                        <span>Confirmed</span>
                    </label>
                    <label class="segmented-check">
                        <InputCheckbox @bind-Value="FormModel.IdentifiersMissing" />
                        <span>Missing</span>
                    </label>
                </div>
            </div>

            <div class="form-row">
                <label>Kit Status</label>
                <div class="status-toolbar">
                    <button type="button" class="dropdown-action">Archival Scenarios</button>
                    <button type="button" class="dropdown-action">Add Hold</button>
                    <button type="button" class="dropdown-action">Add Note</button>
                </div>
            </div>

            <div class="form-row">
                <label for="rackCode">Rack Code</label>
                <div class="scan-input-group">
                    <InputText id="rackCode" class="form-control" @bind-Value="FormModel.RackCode" placeholder="Scan Rack to submit Kit" />
                    <span class="scanner-state" title="Scanner ready">-</span>
                </div>
            </div>

            <div class="details-grid">
                <fieldset class="form-section">
                    <legend>Case Information</legend>
                    <div class="field-group">
                        <label for="createdBy">Created By</label>
                        <InputText id="createdBy" class="form-control" @bind-Value="FormModel.CreatedBy" placeholder="Operator name" />
                    </div>
                    <div class="field-group">
                        <label for="testType">Test Type</label>
                        <InputSelect id="testType" class="form-select" @bind-Value="FormModel.TestType">
                            <option value="">Select test type</option>
                            <option value="Panorama">Panorama</option>
                            <option value="Signatera">Signatera</option>
                            <option value="Empower">Empower</option>
                            <option value="Horizon">Horizon</option>
                        </InputSelect>
                    </div>
                </fieldset>

                <fieldset class="form-section">
                    <legend>Patient Information</legend>
                    <div class="input-row">
                        <div class="field-group">
                            <label for="firstName">First Name</label>
                            <InputText id="firstName" class="form-control" @bind-Value="FormModel.FirstName" />
                        </div>
                        <div class="field-group">
                            <label for="lastName">Last Name</label>
                            <InputText id="lastName" class="form-control" @bind-Value="FormModel.LastName" />
                        </div>
                    </div>
                    <div class="input-row">
                        <div class="field-group">
                            <label for="dob">DOB</label>
                            <InputDate id="dob" class="form-control" @bind-Value="FormModel.DOB" />
                        </div>
                        <div class="field-group">
                            <label for="mrn">MRN</label>
                            <InputText id="mrn" class="form-control" @bind-Value="FormModel.MRN" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="form-section">
                    <legend>Kit Handling</legend>
                    <div class="input-row">
                        <div class="field-group">
                            <label for="operatorName">Operator Name</label>
                            <InputText id="operatorName" class="form-control" @bind-Value="FormModel.OperatorName" />
                        </div>
                        <div class="field-group">
                            <label for="receivedAt">Received At</label>
                            <InputDate id="receivedAt" class="form-control" @bind-Value="FormModel.ReceivedAt" />
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Submit Intake</button>
                <a class="btn btn-secondary" href="cases">Cancel</a>
            </div>
        </section>

        <aside class="intake-rail">
            <div class="timer-panel">
                <strong>0:09</strong>
                <span>Today's avg. kit intake</span>
                <span>San Carlos line</span>
            </div>

            <div class="rail-section">
                <h2>Rack Queue</h2>
                <div class="rack-list">
                    <div class="rack-card">
                        <span>Panorama</span>
                        <strong>P2769156-RACK</strong>
                        <small>54074925-2-N</small>
                        <button type="button" class="print-button">Close and print</button>
                    </div>
                    <div class="rack-card danger">
                        <span>Archive</span>
                        <strong>AP2746448-RACK</strong>
                        <small>54096515-2-N</small>
                        <button type="button" class="print-button">Close and print</button>
                    </div>
                    <div class="rack-card">
                        <span>Panorama</span>
                        <strong>P2769029-RACK</strong>
                        <small>45399844-2-N</small>
                        <button type="button" class="print-button">Close and print</button>
                    </div>
                </div>
            </div>

            <div class="rail-section">
                <h2>Requisition</h2>
                <InputFile id="reqFileInput"
                           class="file-control"
                           OnChange="HandleFileSelected"
                           accept="application/pdf,image/*" />

                @if (!string.IsNullOrWhiteSpace(SelectedFileName))
                {
                    <p class="selected-file">@SelectedFileName</p>
                }

                <div class="document-actions">
                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            @onclick="ShowPdfPreview"
                            disabled="@(SelectedFile is null)">
                        Preview
                    </button>
                    <label class="check-line">
                        <input type="checkbox" @bind="IsDocumentVerified" />
                        <span>Verified</span>
                    </label>
                </div>
            </div>

            <div class="rail-section">
                <h2>Tube Photo</h2>
                <InputFile class="file-control" OnChange="HandleTubePhotoSelected" accept="image/*" />

                @if (!string.IsNullOrWhiteSpace(SelectedTubePhotoName))
                {
                    <p class="selected-file">@SelectedTubePhotoName</p>
                }

                <div class="camera-actions">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="StartCamera">
                        Start
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="CaptureTubePhoto">
                        Capture
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="StopCamera">
                        Stop
                    </button>
                </div>

                <video id="tubeVideo"
                       class="camera-frame"
                       autoplay
                       muted
                       playsinline>
                </video>

                <canvas id="tubeCanvas" style="display:none;"></canvas>

                @if (CapturedTubePhotos.Any())
                {
                    <div class="captured-grid">
                        @foreach (var photo in CapturedTubePhotos)
                        {
                            <div class="photo-thumb">
                                <img src="@photo.PreviewUrl" alt="Captured tube" />
                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        @onclick="() => RemoveCapturedTubePhoto(photo)">
                                    Delete
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </aside>
    </EditForm>
</div>

@code {
    private IntakeFormModel FormModel { get; set; } = new();
    private string? StatusMessage;
    private IBrowserFile? SelectedFile;
    private string? SelectedFileName;
    private string? SelectedFileContentType;
    private bool ShowToast = false;
    private string ToastMessage = string.Empty;
    private string ToastBackgroundColor = "#198754";
    private bool ShowPreviewModal;
    private string? PreviewDocumentUrl;
    private bool IsDocumentVerified;
    private IBrowserFile? SelectedTubePhoto;
    private string? SelectedTubePhotoName;
    private List<CapturedTubePhotoModel> CapturedTubePhotos { get; set; } = new();
    private bool IsSelectedDocumentImage =>
        SelectedFileContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;

    private class CapturedTubePhotoModel
    {
        public string PreviewUrl { get; set; } = string.Empty;
        public byte[] Bytes { get; set; } = Array.Empty<byte>();
        public string FileName { get; set; } = string.Empty;
    }

    private async Task StartCamera()
    {
        try
        {
            await JSRuntime.InvokeAsync<bool>("cameraCapture.startCamera", "tubeVideo");
        }
        catch
        {
            await ShowErrorToast("Unable to access camera. Please allow camera permission.");
        }
    }

    private async Task CaptureTubePhoto()
    {
        var dataUrl = await JSRuntime.InvokeAsync<string?>(
            "cameraCapture.capturePhoto",
            "tubeVideo",
            "tubeCanvas");

        if (string.IsNullOrWhiteSpace(dataUrl))
        {
            await ShowErrorToast("Unable to capture tube photo.");
            return;
        }

        var base64Data = dataUrl.Split(',')[1];
        var bytes = Convert.FromBase64String(base64Data);

        CapturedTubePhotos.Add(new CapturedTubePhotoModel
        {
            PreviewUrl = dataUrl,
            Bytes = bytes,
            FileName = $"tube-photo-{DateTime.UtcNow:yyyyMMddHHmmssfff}.jpg"
        });
    }

    private void RemoveCapturedTubePhoto(CapturedTubePhotoModel photo)
    {
        CapturedTubePhotos.Remove(photo);
    }

    private async Task StopCamera()
    {
        await JSRuntime.InvokeVoidAsync("cameraCapture.stopCamera");
    }

    private async Task HandleTubePhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            SelectedTubePhoto = null;
            SelectedTubePhotoName = null;

            await ShowErrorToast("Only image files are allowed for tube photos.");
            return;
        }

        SelectedTubePhoto = file;
        SelectedTubePhotoName = file.Name;
    }

    private async Task ShowPdfPreview()
    {
        if (string.IsNullOrWhiteSpace(PreviewDocumentUrl))
        {
            await ShowErrorToast("No document selected for preview.");
            return;
        }

        ShowPreviewModal = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task ClosePdfPreview()
    {
        ShowPreviewModal = false;
        return Task.CompletedTask;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var isSupportedDocument =
            file.ContentType == "application/pdf" ||
            file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

        if (!isSupportedDocument)
        {
            SelectedFile = null;
            SelectedFileName = null;
            SelectedFileContentType = null;
            IsDocumentVerified = false;
            await RevokeDocumentPreviewUrl();

            await ShowErrorToast("Only PDF or image files are allowed.");
            return;
        }

        await RevokeDocumentPreviewUrl();

        SelectedFile = file;
        SelectedFileName = file.Name;
        SelectedFileContentType = file.ContentType;
        IsDocumentVerified = false;

        PreviewDocumentUrl = await JSRuntime.InvokeAsync<string?>(
            "pdfPreview.createUrl",
            "reqFileInput");
    }

    private async Task RevokeDocumentPreviewUrl()
    {
        if (!string.IsNullOrWhiteSpace(PreviewDocumentUrl))
        {
            await JSRuntime.InvokeVoidAsync("pdfPreview.revokeUrl", PreviewDocumentUrl);
            PreviewDocumentUrl = null;
        }
    }

    private void CloseToast()
    {
        ShowToast = false;
    }

    private async Task ShowSuccessToast(string message)
    {
        ToastBackgroundColor = "#198754";
        await ShowToastMessage(message);
    }

    private async Task ShowErrorToast(string message)
    {
        ToastBackgroundColor = "#dc3545";
        await ShowToastMessage(message);
    }

    private async Task ShowToastMessage(string message)
    {
        ToastMessage = message;
        ShowToast = true;

        StateHasChanged();

        await Task.Delay(5000);

        if (ShowToast)
        {
            ShowToast = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (SelectedFile is null)
            {
                await ShowErrorToast("Please upload a requisition before submitting.");
                return;
            }

            if (SelectedTubePhoto is null && !CapturedTubePhotos.Any())
            {
                await ShowErrorToast("Please upload or capture at least one tube photo before submitting.");
                return;
            }

            if (!IsDocumentVerified)
            {
                await ShowErrorToast("Please preview and verify the uploaded document before submitting.");
                return;
            }

            var client = HttpClientFactory.CreateClient("ApiClient");

            var caseResponse = await client.PostAsJsonAsync("api/cases", new
            {
                FormModel.CreatedBy,
                FormModel.TestType
            });

            caseResponse.EnsureSuccessStatusCode();

            var createdCase = await caseResponse.Content.ReadFromJsonAsync<CaseResponseModel>();

            if (createdCase is null)
            {
                StatusMessage = "Failed to create case.";
                return;
            }

            var patientResponse = await client.PostAsJsonAsync(
                $"api/cases/{createdCase.CaseId}/patient",
                new
                {
                    FormModel.FirstName,
                    FormModel.LastName,
                    FormModel.DOB,
                    FormModel.MRN
                });

            patientResponse.EnsureSuccessStatusCode();

            var kitResponse = await client.PostAsJsonAsync(
                $"api/cases/{createdCase.CaseId}/kit-info",
                new
                {
                    FormModel.KitBoxCode,
                    FormModel.LotCode,
                    FormModel.OperatorName,
                    FormModel.ReceivedAt
                });

            kitResponse.EnsureSuccessStatusCode();

            if (SelectedFile is not null)
            {
                using var content = new MultipartFormDataContent();

                var fileContent = new StreamContent(SelectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
                fileContent.Headers.ContentType =
                    new System.Net.Http.Headers.MediaTypeHeaderValue(SelectedFile.ContentType);

                content.Add(fileContent, "file", SelectedFile.Name);

                var uploadResponse = await client.PostAsync(
                    $"api/cases/{createdCase.CaseId}/documents",
                    content);

                uploadResponse.EnsureSuccessStatusCode();
            }

            var submittedCaseId = createdCase.CaseId;
            var statusResponse = await client.PatchAsJsonAsync(
                $"api/cases/{createdCase.CaseId}/status",
                "ReadyForReview");

            statusResponse.EnsureSuccessStatusCode();

            if (SelectedTubePhoto is not null)
            {
                using var tubeContent = new MultipartFormDataContent();

                var tubeFileContent = new StreamContent(
                    SelectedTubePhoto.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));

                tubeFileContent.Headers.ContentType =
                    new System.Net.Http.Headers.MediaTypeHeaderValue(SelectedTubePhoto.ContentType);

                tubeContent.Add(tubeFileContent, "file", SelectedTubePhoto.Name);

                var tubeUploadResponse = await client.PostAsync(
                    $"api/cases/{createdCase.CaseId}/tube-photos",
                    tubeContent);

                tubeUploadResponse.EnsureSuccessStatusCode();
            }

            foreach (var photo in CapturedTubePhotos)
            {
                using var capturedContent = new MultipartFormDataContent();

                var capturedFileContent = new ByteArrayContent(photo.Bytes);
                capturedFileContent.Headers.ContentType =
                    new System.Net.Http.Headers.MediaTypeHeaderValue("image/jpeg");

                capturedContent.Add(capturedFileContent, "file", photo.FileName);

                var capturedUploadResponse = await client.PostAsync(
                    $"api/cases/{createdCase.CaseId}/tube-photos",
                    capturedContent);

                capturedUploadResponse.EnsureSuccessStatusCode();
            }

            CapturedTubePhotos.Clear();
            await StopCamera();
            SelectedTubePhoto = null;
            SelectedTubePhotoName = null;
            IsDocumentVerified = false;
            ShowPreviewModal = false;
            FormModel = new IntakeFormModel();
            SelectedFile = null;
            SelectedFileName = null;
            SelectedFileContentType = null;
            await RevokeDocumentPreviewUrl();

            await ShowSuccessToast($"Case {submittedCaseId} created successfully");
        }
        catch (Exception ex)
        {
            await ShowErrorToast($"Error: {ex.Message}");
        }
    }

    public class CaseResponseModel
    {
        public int CaseId { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? TestType { get; set; }
        public DateTime CreatedAt { get; set; }
        public string CreatedBy { get; set; } = string.Empty;
    }
}
