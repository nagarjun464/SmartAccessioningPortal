@page "/cases"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using SmartAccessioningPortal.Web.Models
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Case Queue</PageTitle>

<div class="portal-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">Accessioning operations</p>
            <h1>Case Queue</h1>
            <p>Track intake drafts, ready-for-review cases, patient identifiers, and kit information.</p>
        </div>
        <div class="heading-actions">
            <a class="btn btn-primary" href="cases/new">New Intake Case</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-error">@ErrorMessage</div>
    }

    <section class="work-surface list-surface">
        @if (CaseList is null)
        {
            <div class="loading-row">Loading cases...</div>
        }
        else
        {
            <div class="metric-grid">
                <div class="metric-card">
                    <span>Total Cases</span>
                    <strong>@TotalCount</strong>
                    <small>All accessioning records</small>
                </div>
                <div class="metric-card">
                    <span>Draft</span>
                    <strong>@DraftCount</strong>
                    <small>Needs completion</small>
                </div>
                <div class="metric-card">
                    <span>Ready</span>
                    <strong>@ReadyCount</strong>
                    <small>Waiting for review</small>
                </div>
            </div>

            <div class="queue-toolbar">
                <div class="filter-group" aria-label="Case status filters">
                    <button type="button" class="filter-button @(SelectedStatus == "All" ? "active" : "")" @onclick="SelectAll">
                        All <span>@TotalCount</span>
                    </button>
                    <button type="button" class="filter-button @(SelectedStatus == "Draft" ? "active" : "")" @onclick="SelectDraft">
                        Draft <span>@DraftCount</span>
                    </button>
                    <button type="button" class="filter-button @(SelectedStatus == "ReadyForReview" ? "active" : "")" @onclick="SelectReady">
                        Ready For Review <span>@ReadyCount</span>
                    </button>
                </div>

                <label class="queue-search">
                    <span class="visually-hidden">Search cases</span>
                    <input class="form-control"
                           placeholder="Search by case ID, status, test type, patient, kit, or created by..."
                           @bind="SearchText"
                           @bind:event="oninput" />
                </label>
            </div>

            @if (!FilteredCases.Any())
            {
                <div class="empty-state">
                    <h2>No cases found</h2>
                    <p>Try a different filter or start a new intake case.</p>
                    <a class="btn btn-primary" href="cases/new">New Intake Case</a>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Case</th>
                                <th>Status</th>
                                <th>Test Type</th>
                                <th>Patient</th>
                                <th>Kit Box Code</th>
                                <th>Lot Code</th>
                                <th>Created By</th>
                                <th>Created At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FilteredCases)
                            {
                                <tr>
                                    <td>
                                        <a class="case-link" href="@($"/cases/{item.CaseId}")">
                                            CASE-@item.CaseId.ToString("D5")
                                        </a>
                                    </td>
                                    <td>
                                        <span class="@GetStatusBadgeClass(item.Status)">
                                            @GetStatusLabel(item.Status)
                                        </span>
                                    </td>
                                    <td>@DisplayValue(item.TestType)</td>
                                    <td>@GetPatientName(item)</td>
                                    <td>@DisplayValue(item.KitBoxCode)</td>
                                    <td>@DisplayValue(item.LotCode)</td>
                                    <td>@DisplayValue(item.CreatedBy)</td>
                                    <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
</div>

@code {
    private List<CaseListItemModel>? CaseList;
    private string? ErrorMessage;
    private string SearchText { get; set; } = string.Empty;
    private string SelectedStatus = "All";

    private int TotalCount => CaseList?.Count ?? 0;
    private int DraftCount => CaseList?.Count(x => x.Status == "Draft") ?? 0;
    private int ReadyCount => CaseList?.Count(x => x.Status == "ReadyForReview") ?? 0;

    private IEnumerable<CaseListItemModel> FilteredCases
    {
        get
        {
            var query = CaseList ?? [];

            if (SelectedStatus != "All")
            {
                query = query.Where(x => x.Status == SelectedStatus).ToList();
            }

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                query = query.Where(x =>
                    x.CaseId.ToString().Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    x.Status.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    (x.TestType != null && x.TestType.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
                    x.CreatedBy.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    (x.PatientFirstName != null && x.PatientFirstName.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.PatientLastName != null && x.PatientLastName.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.KitBoxCode != null && x.KitBoxCode.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.LotCode != null && x.LotCode.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
                ).ToList();
            }

            return query;
        }
    }

    private void SelectAll()
    {
        SelectedStatus = "All";
    }

    private void SelectDraft()
    {
        SelectedStatus = "Draft";
    }

    private void SelectReady()
    {
        SelectedStatus = "ReadyForReview";
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string GetPatientName(CaseListItemModel item)
    {
        var name = $"{item.PatientFirstName} {item.PatientLastName}".Trim();
        return string.IsNullOrWhiteSpace(name) ? "-" : name;
    }

    private static string GetStatusLabel(string status)
    {
        return status switch
        {
            "ReadyForReview" => "Ready For Review",
            "Draft" => "Draft",
            _ => status
        };
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "ReadyForReview" => "status-pill status-ready",
            "Draft" => "status-pill status-draft",
            _ => "status-pill status-neutral"
        };
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("ApiClient");
            CaseList = await client.GetFromJsonAsync<List<CaseListItemModel>>("api/cases");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading cases: {ex.Message}";
            CaseList = new List<CaseListItemModel>();
        }
    }
}
