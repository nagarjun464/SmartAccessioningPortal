@page "/cases/{CaseId:int}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using SmartAccessioningPortal.Web.Models
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Case @CaseId</PageTitle>

<div class="portal-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">Case record</p>
            <h1>CASE-@CaseId.ToString("D5")</h1>
            <p>Review accessioning metadata, requisition documents, and tube photo evidence.</p>
        </div>
        <div class="heading-actions">
            <button type="button" class="btn btn-secondary" @onclick="GoBack">Back to Queue</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-error">@ErrorMessage</div>
    }

    @if (CaseDetail is null)
    {
        <section class="work-surface details-surface">
            <div class="loading-row">Loading case details...</div>
        </section>
    }
    else
    {
        <div class="detail-layout">
            <section class="work-surface details-surface">
                <div class="record-header">
                    <div>
                        <h2>@DisplayValue(CaseDetail.TestType) Intake</h2>
                        <p>Created by @DisplayValue(CaseDetail.CreatedBy) on @CaseDetail.CreatedAt.ToLocalTime().ToString("g")</p>
                    </div>
                    <span class="@GetStatusBadgeClass(CaseDetail.Status)">
                        @GetStatusLabel(CaseDetail.Status)
                    </span>
                </div>

                <div class="info-grid">
                    <div class="info-panel">
                        <h3>Case Information</h3>
                        <dl class="data-list">
                            <dt>Case ID</dt>
                            <dd>CASE-@CaseDetail.CaseId.ToString("D5")</dd>
                            <dt>Status</dt>
                            <dd>@GetStatusLabel(CaseDetail.Status)</dd>
                            <dt>Test Type</dt>
                            <dd>@DisplayValue(CaseDetail.TestType)</dd>
                            <dt>Created By</dt>
                            <dd>@DisplayValue(CaseDetail.CreatedBy)</dd>
                            <dt>Created At</dt>
                            <dd>@CaseDetail.CreatedAt.ToLocalTime().ToString("g")</dd>
                        </dl>
                    </div>

                    <div class="info-panel">
                        <h3>Patient Information</h3>
                        @if (CaseDetail.Patient is null)
                        {
                            <p class="selected-file">No patient information found.</p>
                        }
                        else
                        {
                            <dl class="data-list">
                                <dt>First Name</dt>
                                <dd>@DisplayValue(CaseDetail.Patient.FirstName)</dd>
                                <dt>Last Name</dt>
                                <dd>@DisplayValue(CaseDetail.Patient.LastName)</dd>
                                <dt>DOB</dt>
                                <dd>@(CaseDetail.Patient.DOB?.ToString("MM/dd/yyyy") ?? "-")</dd>
                                <dt>MRN</dt>
                                <dd>@DisplayValue(CaseDetail.Patient.MRN)</dd>
                            </dl>
                        }
                    </div>

                    <div class="info-panel">
                        <h3>Kit Information</h3>
                        @if (CaseDetail.KitInfo is null)
                        {
                            <p class="selected-file">No kit information found.</p>
                        }
                        else
                        {
                            <dl class="data-list">
                                <dt>Kit Box Code</dt>
                                <dd>@DisplayValue(CaseDetail.KitInfo.KitBoxCode)</dd>
                                <dt>Lot Code</dt>
                                <dd>@DisplayValue(CaseDetail.KitInfo.LotCode)</dd>
                                <dt>Operator</dt>
                                <dd>@DisplayValue(CaseDetail.KitInfo.OperatorName)</dd>
                                <dt>Received At</dt>
                                <dd>@CaseDetail.KitInfo.ReceivedAt.ToLocalTime().ToString("g")</dd>
                            </dl>
                        }
                    </div>
                </div>

                <div class="asset-section">
                    <h3>Documents</h3>
                    @if (!CaseDetail.Documents.Any())
                    {
                        <div class="empty-state">
                            <h2>No documents uploaded</h2>
                            <p>This case does not have a requisition file attached yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Document</th>
                                        <th>Content Type</th>
                                        <th>Uploaded</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var document in CaseDetail.Documents)
                                    {
                                        <tr>
                                            <td>@DisplayValue(document.FileName)</td>
                                            <td>@DisplayValue(document.ContentType)</td>
                                            <td>@document.UploadedAt.ToLocalTime().ToString("g")</td>
                                            <td>
                                                <a class="btn btn-secondary btn-sm"
                                                   href="@GetDocumentDownloadUrl(document.DocumentId)"
                                                   target="_blank">
                                                    View / Download
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="asset-section">
                    <h3>Tube Photos</h3>

                    @if (!TubePhotos.Any())
                    {
                        <div class="empty-state">
                            <h2>No tube photos uploaded</h2>
                            <p>Tube image evidence will appear here after intake capture.</p>
                        </div>
                    }
                    else
                    {
                        <div class="photo-grid">
                            @foreach (var photo in TubePhotos)
                            {
                                <div class="case-photo">
                                    <img src="@GetFullImageUrl(photo.ImageUrl)"
                                         alt="@photo.FileName"
                                         @onclick="() => OpenTubePhoto(photo.ImageUrl)" />

                                    <p>@DisplayValue(photo.FileName)</p>
                                    <small>@photo.CapturedAt.ToLocalTime().ToString("g")</small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>

            <aside class="detail-side">
                <div class="timer-panel">
                    <strong>@(CaseDetail.CreatedAt.ToLocalTime().ToString("HH:mm"))</strong>
                    <span>Local accession time</span>
                    <span>@GetStatusLabel(CaseDetail.Status)</span>
                </div>

                <div class="side-note">
                    <h3>Review Checklist</h3>
                    <p>Confirm two patient identifiers, requisition match, kit barcode, lot code, and tube-photo clarity.</p>
                </div>

                <div class="side-note">
                    <h3>Portfolio Note</h3>
                    <p>This screen demonstrates the full accessioning record flow with API-backed case data and uploaded assets.</p>
                </div>
            </aside>
        </div>
    }

    @if (ShowTubePhotoModal)
    {
        <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="tubePhotoTitle">
            <div class="modal-panel">
                <div class="modal-header">
                    <h2 id="tubePhotoTitle">Tube Photo</h2>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="CloseTubePhotoModal">
                        Close
                    </button>
                </div>

                <div class="document-frame">
                    <img class="photo-modal-image" src="@GetFullImageUrl(SelectedTubePhotoUrl!)" alt="Selected tube" />
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int CaseId { get; set; }

    private CaseDetailsModel? CaseDetail;
    private string? ErrorMessage;
    private List<TubePhotoModel> TubePhotos { get; set; } = new();
    private bool ShowTubePhotoModal;
    private string? SelectedTubePhotoUrl;
    private string ApiBaseUrl { get; set; } = string.Empty;

    private void OpenTubePhoto(string imageUrl)
    {
        SelectedTubePhotoUrl = imageUrl;
        ShowTubePhotoModal = true;
    }

    private void CloseTubePhotoModal()
    {
        ShowTubePhotoModal = false;
        SelectedTubePhotoUrl = null;
    }

    private string GetDocumentDownloadUrl(int documentId)
    {
        return string.IsNullOrWhiteSpace(ApiBaseUrl)
            ? "#"
            : $"{ApiBaseUrl}/api/cases/documents/{documentId}/download";
    }

    private string GetFullImageUrl(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return string.Empty;
        }

        if (Uri.TryCreate(imageUrl, UriKind.Absolute, out _))
        {
            return imageUrl;
        }

        if (string.IsNullOrWhiteSpace(ApiBaseUrl))
        {
            return imageUrl;
        }

        var relativePath = imageUrl.StartsWith('/') ? imageUrl : $"/{imageUrl}";
        return $"{ApiBaseUrl}{relativePath}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("ApiClient");
            ApiBaseUrl = client.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty;
            CaseDetail = await client.GetFromJsonAsync<CaseDetailsModel>($"api/cases/{CaseId}");
            TubePhotos = await client.GetFromJsonAsync<List<TubePhotoModel>>(
                $"api/cases/{CaseId}/tube-photos") ?? new();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading case details: {ex.Message}";
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/cases");
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string GetStatusLabel(string status)
    {
        return status switch
        {
            "ReadyForReview" => "Ready For Review",
            "Draft" => "Draft",
            _ => status
        };
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "ReadyForReview" => "status-pill status-ready",
            "Draft" => "status-pill status-draft",
            _ => "status-pill status-neutral"
        };
    }
}
